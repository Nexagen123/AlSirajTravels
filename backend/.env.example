# Server Configuration
PORT=8007
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/brother_international

# JWT Configuration
JWT_SECRET=swdwefcrevvffgftrgtrfgtrgtrg
JWT_KEY=asd9uaisdnm+832i5u4kl)(hjkshf)sdfjsdkfih
JWT_EXPIRY=6d

# Email Configuration
# Choose one of the following email services:

# Option 1: Gmail (Recommended for quick setup)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password-here

# Option 2: Custom SMTP Server
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.your-domain.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@your-domain.com
# SMTP_PASSWORD=your-smtp-password

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# External API Authentication (Ali Haider Travel API)
# Credentials for pre-authentication with Ali Haider Travel API
ALI_HAIDER_API_URL=https://alhaidertravel.pk
ALI_HAIDER_API_EMAIL=your-external-api-email@example.com
ALI_HAIDER_API_PASSWORD=your-external-api-password

# Optional: If you already have a valid JWT from Al-Haider,
# set it here to skip the login step entirely.
# When set, middleware will use this token for all requests.
# Example (do not commit real tokens):
# ALI_HAIDER_API_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9....

# External API Authentication (FSD Ameer-e-Millat — fsdameeremillattourism.com)
# Credentials for pre-authentication with the Ameer-e-Millat group-ticketing API.
# AgencyName/Mobile are the agent identity Ameer-e-Millat has us registered
# under, sent as `agency_info` on every booking created against their API.
AmmerMilat_API_URL=https://fsdameeremillattourism.com/
AmmerMilat_API_Email=your-external-api-email@example.com
AmmerMilat_API_Password=your-external-api-password
AmmerMilat_API_AgencyName=Your Agency Name
AmmerMilat_API_Mobile=03000000000

# Optional: seed/fallback JWT if you already have one from Ameer-e-Millat.
# The token is cached and auto-refreshed via /api/login once credentials
# above are set, but this is used as a last-resort fallback if login fails.
# Example (do not commit real tokens):
# AmmerMilat_API_Token=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9....

# ===========================================
# HOW TO GET GMAIL APP PASSWORD:
# ===========================================
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (if not already enabled)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and your device (or "Other")
# 5. Click "Generate"
# 6. Copy the 16-character password (remove spaces)
# 7. Paste it in EMAIL_PASSWORD above
#
# IMPORTANT: Use the App Password, NOT your regular Gmail password!
# IMPORTANT: Remove all spaces from the App Password
#
# Test your configuration by running:
#   node testCredentialEmail.js
# ===========================================
